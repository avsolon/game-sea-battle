PORT=3000
NODE_ENV=development

# Разрешённые origins клиента.
# Для production обязательно добавь адрес preview и origins Яндекса.
ALLOWED_ORIGINS=https://games.yandex.ru,https://yandex.ru,https://yandex.com

# Время, в течение которого соперник может вернуться после disconnect.
DISCONNECT_GRACE_MS=60000

# Origins, которым разрешено читать статику с домена бэкенда.
# Нужно, только если страница игры лежит на другом домене.
# Пусто = CORS выключен.
CORS_ORIGINS=