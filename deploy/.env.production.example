# Переменные окружения бэкенда «Морского боя» для продакшена.
#
# Всё уже настроено по умолчанию в docker-compose.yml, поэтому этот файл
# не обязателен. Нужен, только если хотите переопределить значения:
#
#   cp deploy/.env.production.example .env
#   docker compose up -d --build
#
# Docker Compose сам подхватывает .env из папки с docker-compose.yml.

# Домен(ы) сайта, с которых разрешено подключаться к WebSocket.
# Список через запятую, без пробелов и без слэша в конце.
SEA_BATTLE_ALLOWED_ORIGINS=https://asolontsov.ru,https://www.asolontsov.ru

# Порт на хосте, который слушает nginx (внутри контейнера всегда 3000).
# Публикуется только на 127.0.0.1 — снаружи недоступен.
# Должен совпадать с портом в `proxy_pass` в nginx.
SEA_BATTLE_HOST_PORT=8102

# Сколько ждать вернувшегося соперника после обрыва связи, мс.
SEA_BATTLE_DISCONNECT_GRACE_MS=60000

# Необязательно. Заполняйте, только если ассеты игры отдаются с домена
# бэкенда, а страница лежит на другом домене (нужен CORS).
# При размещении на asolontsov.ru оставьте пустым.
SEA_BATTLE_CORS_ORIGINS=
